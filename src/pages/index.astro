---
import Layout from '../layouts/Layout.astro';
import HomeClient from '../components-react/HomeClient.jsx';
import { getAlternateLinks, getPageSeo } from '../lib/site-copy.js';
import { buildHomeStructuredData } from '../lib/home-seo.js';
import { SITE } from '../lib/seo.js';

const seo = getPageSeo('home', 'es');
const homeOgImage = `${SITE.origin}/assets/unidades.png`;

const structuredData = buildHomeStructuredData('es', seo.description);
---

<Layout
    lang="es"
    title={seo.title}
    description={seo.description}
    keywords={seo.keywords}
    image={homeOgImage}
    alternates={getAlternateLinks('home')}
    structuredData={structuredData}
    includeSiteSchemas={false}
>
    <HomeClient client:load lang="es" />
</Layout>
